  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check:contact": "esbuild src/checks/contact.ts --bundle --platform=node --format=esm --outfile=out/checks/contact.mjs --log-level=warning && node out/checks/contact.mjs",
    "timeline": "python3 scripts/build_timeline.py && python3 scripts/peaks.py",
    "render:excerpt": "remotion render Film-Excerpt-Monday public/renders/excerpt-monday.mp4",
    "render:tutorial": "remotion render Tutorial out/tutorial.mp4"
  },
  "allowScripts": {
    "esbuild": false
  }
}
